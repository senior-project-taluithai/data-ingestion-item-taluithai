# TAT API Configuration Example
# Copy this file to .env and fill in your API credentials

# TAT API Key (required for production API access)
TAT_API_KEY=your_api_key_here

# TAT API Base URL (optional, defaults to official API)
TAT_API_BASE_URL=https://tatapi.tourismthailand.org/tatapi/v5

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Output directory for exported data
OUTPUT_DIR=data/output
